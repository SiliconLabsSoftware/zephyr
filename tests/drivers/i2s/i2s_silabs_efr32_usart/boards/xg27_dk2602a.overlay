/*
 * xG27-DK2602A: USART0 I2S on PC0/PC1/PC2 with word-select on PB2.
 * Disables the on-board MX25R8035F flash that otherwise owns USART0.
 *
 * CMU CLKOUT2 (PB0): MCO routing for the test-image-only clock-measurement
 * suite. Not required by the I2S driver itself.
 */

#include <zephyr/dt-bindings/pinctrl/silabs/xg27-pinctrl.h>
#include <zephyr/dt-bindings/dma/silabs/xg27-dma.h>

&dma0 {
	status = "okay";
};

/ {
	aliases {
		i2s-tx = &usart0;
	};
};

&pinctrl {
	usart0_i2s_default: usart0_i2s_default {
		group0 {
			pins = <USART0_TX_PC0>, <USART0_CLK_PC2>, <USART0_CS_PB2>;
			drive-push-pull;
			output-high;
		};

		group1 {
			pins = <USART0_RX_PC1>;
			input-enable;
		};
	};
};

/delete-node/ &mx25r80;

&usart0 {
	compatible = "silabs,efr32-usart-i2s";
	/delete-property/ cs-gpios;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-0 = <&usart0_i2s_default>;
	pinctrl-names = "default";
	silabs,mclk-out = <&clkout2>;
	dmas = <&dma0 DMA_REQSEL_USART0TXBL>,
	       <&dma0 DMA_REQSEL_USART0TXBLRIGHT>,
	       <&dma0 DMA_REQSEL_USART0RXDATAV>;
	dma-names = "txbl", "txblright", "rx";
};

&pinctrl {
	clkout_default: clkout_default {
		group0 {
			pins = <CMU_CLKOUT2_PB0>;
			drive-push-pull;
		};
	};
};

/ {
	exportclk: exportclk {
		compatible = "silabs,series2-exportclk";
		#clock-cells = <0>;
		status = "okay";
	};
};

&cmu {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&clkout_default>;
	pinctrl-names = "default";

	clkout2: clkout@2 {
		compatible = "silabs,series-clock-clkout";
		reg = <2>;
		#clock-cells = <0>;
		clocks = <&exportclk>;
		clock-div = <4>;
	};
};
